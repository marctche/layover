# Supabase project URL. Public (browser-safe). Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key. Public (browser-safe). Supabase dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key. SERVER-ONLY, never expose to the browser. Supabase dashboard > Project Settings > API Keys.
SUPABASE_SECRET_KEY=
# Anthropic API key. SERVER-ONLY, never expose to the browser. console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
